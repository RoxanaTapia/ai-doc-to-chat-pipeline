# Build context is the repo root. The image copies requirements.txt,
# configs/, src/, .streamlit/config.toml, and docs/product/sample-nda.pdf.

# VCS / editor
.git
.github
.cursor
.vscode
.idea

# Local environments
.venv
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage

# Secrets
.env
.env.*
!.env.example

# Streamlit local extras (keep the committed theme config)
.streamlit/*
!.streamlit/config.toml

# Runtime leftovers
data/
samples/
uploaded/
*.faiss
*.index
.huggingface/
.cache/

# Tests are not needed at runtime
tests/

# Client PDFs stay out; the walkthrough sample is copied into the image
*.pdf
!docs/product/sample-nda.pdf
