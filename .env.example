# Product knobs. Copy to `.env` and fill only what you use.
# Empty means "use configs/config.yaml" (and Compose defaults for Ollama).
# Never commit a filled `.env`.

# -----------------------------------------------------------------------------
# Answer writer
# -----------------------------------------------------------------------------
# ollama | anthropic | dummy
# Empty: Ollama unless USE_DUMMY_GENERATOR=true (or Streamlit dummy mode).
# Non-empty LLM_PROVIDER always wins.
LLM_PROVIDER=
USE_DUMMY_GENERATOR=

ANTHROPIC_API_KEY=
# Empty = claude-haiku-4-5-20251001 (sidebar label: Claude Haiku 4.5).
ANTHROPIC_MODEL=

# Reserved; the OpenAI path is not implemented yet.
OPENAI_API_KEY=

# Optional Hugging Face Hub token (faster embedding / reranker downloads).
HF_TOKEN=

# -----------------------------------------------------------------------------
# Ollama (self-host writer)
# -----------------------------------------------------------------------------
# Compose network: http://ollama:11434
# Streamlit on the host + Ollama in Docker on 11435: http://127.0.0.1:11435
# Native Ollama on the host: http://127.0.0.1:11434
OLLAMA_HOST=

# Empty = configs/config.yaml rag.generation (Compose default: llama3.1:8b).
# CPU / 8 GB RAM: phi3:mini
OLLAMA_MODEL=
OLLAMA_MAX_NEW_TOKENS=
OLLAMA_TEMPERATURE=
OLLAMA_TOP_P=
OLLAMA_DO_SAMPLE=
OLLAMA_FALLBACK_TO_DUMMY=
OLLAMA_NUM_CTX=
OLLAMA_TIMEOUT_SECONDS=

# -----------------------------------------------------------------------------
# Thin API (optional)
# -----------------------------------------------------------------------------
# When set, Streamlit POSTs /chat here instead of generating in-process.
# Local: http://127.0.0.1:8000
# Compose (app → api): http://api:8000
API_BASE_URL=

# -----------------------------------------------------------------------------
# UI
# -----------------------------------------------------------------------------
# client = pilot (no retrieval debug). developer = local tuning.
APP_PRESENTATION_MODE=client
APP_ALLOW_DEV_TOGGLE=false

# -----------------------------------------------------------------------------
# Compose
# -----------------------------------------------------------------------------
# Keeps Ollama volume names stable. The edge stack must pass -p roxanatapia-edge
# so it does not inherit this name.
COMPOSE_PROJECT_NAME=ai-doc-to-chat-pipeline

# HTTPS, invites, SMTP, and Turnstile are owned by roxanatapia-edge.
# On the portfolio VPS that stack still reads this repo's live `.env`.
# Keep those keys on the server file only; do not add them here.
