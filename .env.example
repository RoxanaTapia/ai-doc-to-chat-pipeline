# Product knobs. Copy to `.env` and fill only what you use.
# Empty means "use configs/config.yaml".
# Never commit a filled `.env`.

# -----------------------------------------------------------------------------
# Answer writer
# -----------------------------------------------------------------------------
# anthropic (Claude, the default) | openai | xai (Grok) | dummy
# Empty: Claude, unless USE_DUMMY_GENERATOR=true (or the API dummy_mode flag).
# A non-empty LLM_PROVIDER always wins.
# The selected provider reads only its own key. A missing key is an error.
# Dummy mode answers without any key.
LLM_PROVIDER=
USE_DUMMY_GENERATOR=

# Claude (default). Empty model = claude-haiku-4-5-20251001 (sidebar: Claude Haiku 4.5).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# OpenAI. Empty model = gpt-4.1-mini (sidebar: GPT-4.1 mini).
OPENAI_API_KEY=
OPENAI_MODEL=

# Grok, via the xAI API. Empty model = grok-4.7 (sidebar: Grok 4.7).
XAI_API_KEY=
XAI_MODEL=

# Optional shared sampling overrides. Empty = configs/config.yaml rag.generation.
LLM_MAX_NEW_TOKENS=
LLM_TEMPERATURE=
LLM_TOP_P=
LLM_DO_SAMPLE=
LLM_TIMEOUT_SECONDS=

# Optional Hugging Face Hub token (faster embedding / reranker downloads).
HF_TOKEN=

# -----------------------------------------------------------------------------
# Thin API (optional)
# -----------------------------------------------------------------------------
# When set, Streamlit POSTs /chat here instead of generating in-process.
# Local: http://127.0.0.1:8000
# Compose (app → api): http://api:8000
API_BASE_URL=

# -----------------------------------------------------------------------------
# UI
# -----------------------------------------------------------------------------
# client = pilot (no retrieval debug). developer = local tuning.
APP_PRESENTATION_MODE=client
APP_ALLOW_DEV_TOGGLE=false

# Avoid Hugging Face tokenizer deadlocks on the first question (Streamlit).
TOKENIZERS_PARALLELISM=false

# Shown after the third answer as "Message me on Upwork." Empty hides the whole line.
DEMO_BOOKING_URL=https://www.upwork.com/freelancers/roxanadev

# -----------------------------------------------------------------------------
# Compose
# -----------------------------------------------------------------------------
# Keeps Compose project names stable across projects.
COMPOSE_PROJECT_NAME=ai-doc-to-chat-pipeline

# Public HTTPS belongs with an existing reverse proxy in front of the app.
# Do not add proxy or TLS settings here.
